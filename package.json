{
  "name": "cnode09-login",
  "version": "1.0.0",
  "description": "App + Api Rest para registro y logueo de usuario",
  "author": "Ariel Bedini",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--trace-warnings' tsx watch src/app.ts",
    "build": "rimraf ./dist && tsc -p tsconfig.build.json",
    "start": "npm run build && node ./dist/app.js",
    "docker:test": "docker compose -f docker-compose.test.yml --env-file .env.test",
    "prisma-migrate": "npx prisma migrate deploy",
    "test": "npm run docker:test && jest",
    "test:watch": "tsc --NoEmit && npx jest --watch",
    "test:coverage": "npm run docker:test && npx jest --coverage",
    "test:prisma-migrate": "dotenv -e .env.test -- npx prisma migrate deploy",
    "test:prisma": "dotenv -e .env.sample -- jest -i"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "env-var": "^7.5.0",
    "express": "^5.3.0"
  }
}
